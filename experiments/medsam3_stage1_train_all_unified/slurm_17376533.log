    _target_: sam3.model_builder.build_sam3_video_model
    bpe_path: ${paths.bpe_path}
    matcher: ${scratch.matcher}
    device: cuda
    compile: false
    has_presence_token: true
    geo_encoder_use_img_cross_attn: true
    apply_temporal_disambiguation: true
    training_mode: true
    checkpoint_path: /anvil/projects/x-cis250950/sam3/experiments/sam3_stage0.pt
    load_from_HF: false
  meters: null
  optim:
    amp:
      enabled: true
      amp_dtype: bfloat16
    optimizer:
      _target_: torch.optim.AdamW
    gradient_clip:
      _target_: sam3.train.optim.optimizer.GradientClipper
      max_norm: 0.1
      norm_type: 2
    options:
      lr:
      - scheduler:
          _target_: sam3.train.optim.schedulers.InverseSquareRootParamScheduler
          base_lr: ${scratch.lr_decoder}
          timescale: 10
          warmup_steps: 100
          cooldown_steps: 50
        param_names:
        - detector.segmentation_head.*
        - detector.transformer.decoder.*
        - detector.dot_prod_scoring.*
        - tracker.sam_mask_decoder.*
      - scheduler:
          _target_: sam3.train.optim.schedulers.InverseSquareRootParamScheduler
          base_lr: ${scratch.lr_vision_backbone}
          timescale: 10
          warmup_steps: 100
          cooldown_steps: 50
        param_names:
        - detector.backbone.vision_backbone.*
        - tracker.maskmem_backbone.*
        layer_decay: ${scratch.lrd_vision_backbone}
      - scheduler:
          _target_: sam3.train.optim.schedulers.InverseSquareRootParamScheduler
          base_lr: ${scratch.lr_language_backbone}
          timescale: 10
          warmup_steps: 100
          cooldown_steps: 50
        param_names:
        - detector.backbone.language_backbone.*
      - scheduler:
          _target_: sam3.train.optim.schedulers.InverseSquareRootParamScheduler
          base_lr: ${scratch.lr_prompt_encoder}
          timescale: 10
          warmup_steps: 100
          cooldown_steps: 50
        param_names:
        - detector.geometry_encoder.*
      - scheduler:
          _target_: fvcore.common.param_scheduler.ConstantParamScheduler
          value: 1.0e-05
        param_names:
        - detector.transformer.encoder.*
        - tracker.transformer.encoder.*
      weight_decay:
      - scheduler:
          _target_: fvcore.common.param_scheduler.ConstantParamScheduler
          value: ${scratch.wd}
      - scheduler:
          _target_: fvcore.common.param_scheduler.ConstantParamScheduler
          value: 0.0
        param_names:
        - '*bias*'
        module_cls_names:
        - torch.nn.LayerNorm
  checkpoint:
    save_dir: ${launcher.experiment_log_dir}/checkpoints
    save_freq: 1
  logging:
    tensorboard_writer:
      _target_: sam3.train.utils.logger.make_tensorboard_logger
      log_dir: ${launcher.experiment_log_dir}/tensorboard
      flush_secs: 120
      should_log: true
    wandb_writer: null
    log_dir: ${launcher.experiment_log_dir}/logs
    log_freq: 50
launcher:
  num_nodes: 1
  gpus_per_node: 1
  experiment_log_dir: ${paths.experiment_log_dir}
  multiprocessing_context: forkserver
submitit:
  account: null
  partition: null
  qos: null
  timeout_hour: 24
  use_cluster: false
  cpus_per_task: 16
  port_range:
  - 10000
  - 65000

